# =============================================================================
# ShortLink 部署环境变量(可与 backend/.env 重叠)
# 这里主要放容器编排相关:端口、网络密码等
# backend 应用的配置仍从 backend/.env 读
# =============================================================================

# Nginx 暴露端口
NGINX_HTTP_PORT=80

# MySQL 端口(开发模式可暴露到主机)
MYSQL_HOST_PORT=3306

# Redis 端口
REDIS_HOST_PORT=6379

# MySQL root 密码(生产必须改)
MYSQL_ROOT_PASSWORD=please-change-me

# 兼容 backend 的 DB / Redis 字段(避免同时维护两份)
DB_HOST=mysql
DB_PORT=3306
DB_USER=shortlink
DB_PASSWORD=please-change-me
DB_NAME=shortlink
DB_CHARSET=utf8mb4

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
